# Power BI / Excel local BI login (copy to .env_local)
# Used by: Power BI Desktop credential dialog; Excel daily-close connection dialog
# Not loaded by mdc, settings_v2, or dbt_env.py.
#
# Warehouse host, port, and database come from dbt_dental_models/.env_local
# (POSTGRES_ANALYTICS_HOST / PORT / DB). This login is bi_user, not analytics_user.
# Do not copy these keys into etl_pipeline/.env_* or api/.env_api_*.
# Clinic bi_user belongs in Secrets Manager, not in this file.

POSTGRES_BI_USER=bi_user
POSTGRES_BI_PASSWORD=your_password
