{
  "metadata": {
    "description": "QuickBooks Online login and API credentials template",
    "note": "Copy this file to quickbooks_credentials.json in the same folder and fill in real values. quickbooks_credentials.json is gitignored. Do not commit passwords, client secrets, or tokens."
  },
  "subscription": "plus",
  "admin_login": {
    "email": "<ADMIN_EMAIL>",
    "password": "<ADMIN_PASSWORD>",
    "note": "Company admin. Use only to invite the reports user. Do not connect the app with this login."
  },
  "integration_user": {
    "role": "view_company_reports",
    "first_name": "<ACCOUNTABLE_FIRST_NAME>",
    "last_name": "<ACCOUNTABLE_LAST_NAME>",
    "email": "<REPORTS_USER_EMAIL>",
    "password": "<REPORTS_USER_PASSWORD>",
    "note": "Plus has no view-only transaction role. This user can run reports and cannot edit transactions. Name is the accountable person. Email must be a mailbox you can open, and it cannot be the admin address. QuickBooks allows only letters, numbers, periods, and @ in the email."
  },
  "app": {
    "client_id": "<QUICKBOOKS_CLIENT_ID>",
    "client_secret": "<QUICKBOOKS_CLIENT_SECRET>",
    "redirect_uri": "http://localhost:8080/callback",
    "environment": "sandbox",
    "note": "Client ID and secret come from the Intuit app Keys & OAuth page. Use sandbox until a production company is connected. environment is sandbox or production."
  },
  "companies": {
    "MDC": {
      "company_name": "<MDC_COMPANY_NAME>",
      "realm_id": "<MDC_REALM_ID>",
      "access_token": "<MDC_ACCESS_TOKEN>",
      "refresh_token": "<MDC_REFRESH_TOKEN>",
      "refresh_token_expires_at": "<YYYY-MM-DD>"
    },
    "GLIC": {
      "company_name": "<GLIC_COMPANY_NAME>",
      "realm_id": "<GLIC_REALM_ID>",
      "access_token": "<GLIC_ACCESS_TOKEN>",
      "refresh_token": "<GLIC_REFRESH_TOKEN>",
      "refresh_token_expires_at": "<YYYY-MM-DD>"
    }
  }
}
