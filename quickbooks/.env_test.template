# QuickBooks test environment
# Used by: QUICKBOOKS (python -m quickbooks … --env test, or QUICKBOOKS_ENVIRONMENT=test)
# Same Intuit sandbox host as local. Unit tests pass their own file and can leave this blank.
# Intuit app "MDC Analytics". Use the development keys, the same pair as .env_local.
# Copy to quickbooks/.env_test only when a sandbox company is used for integration tests.

QUICKBOOKS_ENVIRONMENT=test

QUICKBOOKS_CLIENT_ID=
