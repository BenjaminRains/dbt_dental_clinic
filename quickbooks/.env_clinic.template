# QuickBooks clinic environment
# Used by: QUICKBOOKS (python -m quickbooks … --env clinic, or QUICKBOOKS_ENVIRONMENT=clinic)
# WARNING: Real clinic books. This stage calls the Intuit production API.
# Copy to quickbooks/.env_clinic and fill in. Do not commit the copy.
#
# clinic is production. Do not invent a production or sandbox stage name.
# There is no demo stage: portfolio data must not use the clinic company.

QUICKBOOKS_ENVIRONMENT=clinic

# Intuit app "MDC Analytics". These must be the production keys.
# Development keys from an "In development" app only work in .env_local.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:8080/callback
QUICKBOOKS_OAUTH_STATE=

# Reports user (View company reports). The company admin is not stored here.
QUICKBOOKS_INTEGRATION_USER_ROLE=view_company_reports
QUICKBOOKS_INTEGRATION_USER_FIRST_NAME=
QUICKBOOKS_INTEGRATION_USER_LAST_NAME=
QUICKBOOKS_INTEGRATION_USER_EMAIL=
QUICKBOOKS_INTEGRATION_USER_PASSWORD=

# MDC company. Realm and tokens are written by: python -m quickbooks --env clinic exchange
MDC_QUICKBOOKS_COMPANY_NAME=
MDC_QUICKBOOKS_REALM_ID=
MDC_QUICKBOOKS_ACCESS_TOKEN=
MDC_QUICKBOOKS_REFRESH_TOKEN=
MDC_QUICKBOOKS_ACCESS_TOKEN_EXPIRES_AT=
MDC_QUICKBOOKS_REFRESH_TOKEN_EXPIRES_AT=

# GLIC company
GLIC_QUICKBOOKS_COMPANY_NAME=
GLIC_QUICKBOOKS_REALM_ID=
GLIC_QUICKBOOKS_ACCESS_TOKEN=
GLIC_QUICKBOOKS_REFRESH_TOKEN=
GLIC_QUICKBOOKS_ACCESS_TOKEN_EXPIRES_AT=
GLIC_QUICKBOOKS_REFRESH_TOKEN_EXPIRES_AT=
